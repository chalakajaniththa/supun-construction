// Supun Construction — full data model (overview §6). Implemented completely in Step 1;
// later steps only add features on top of it. Any rename/removal must be logged in docs/DRIFT-LOG.md.
//
// Conventions
// - M = money  → Decimal(14,2) · Q = quantity → Decimal(14,3) · percentages → Decimal(7,4)
// - Calendar days use @db.Date, allocations use @db.Timestamptz.
// - Every table has createdAt / updatedAt. Master data has deletedAt (soft delete).
// - Enums mirror packages/shared/src/enums.ts exactly (checked by a unit test).
// - DB-only features (btree_gist exclusion constraints) live as raw SQL in migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────── Enums ─────────────────────────────────

enum NotificationSeverity {
  INFO
  WARNING
  DANGER
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
}

enum BackupDestination {
  LOCAL
  GDRIVE
  BOTH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum ClientType {
  GOVERNMENT
  PRIVATE
}

enum SupplierType {
  MATERIAL
  HARDWARE
  FUEL
  SUBCONTRACTOR
  EQUIPMENT_HIRE
  OTHER
}

enum ProjectType {
  ROAD
  BUILDING
  SCHOOL_BUILDING
  BRIDGE_CULVERT
  IRRIGATION
  OTHER
}

enum ProjectSource {
  GOVERNMENT_TENDER
  PRIVATE
}

enum ProjectStatus {

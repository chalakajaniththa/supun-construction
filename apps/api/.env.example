# Local development of the API on the host (copy to apps/api/.env). Infra: docker-compose.dev.yml.
NODE_ENV=development
PORT=4000
TZ=Asia/Colombo
DATABASE_URL=postgresql://supun:supun@localhost:5433/supun_dev
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
S3_ENDPOINT=http://localhost:8334
S3_REGION=us-east-1
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key
S3_BUCKET=supun-docs
GOTENBERG_URL=http://localhost:3002
SEED_SAMPLE_DATA=true
COOKIE_SECURE=false

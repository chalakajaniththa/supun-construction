# Used by the API e2e tests (vitest.config.e2e.ts). Safe, local-only values.
NODE_ENV=test
TZ=Asia/Colombo
DATABASE_URL=postgresql://supun:supun@localhost:5433/supun_test
JWT_SECRET=test-jwt-secret-0123456789abcdef0123456789

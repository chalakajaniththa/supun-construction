# Supun Construction — configuration for `docker compose` (copy to .env).
# scripts/start.command creates .env from this file automatically and replaces the
# secrets marked "random" with fresh random values (openssl rand -hex 24).

# ── Login ────────────────────────────────────────────────────────────────────
# The first admin account, created on the very first start. Change the password in
# Settings → Password after logging in (a banner reminds you).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Web ──────────────────────────────────────────────────────────────────────
# The app opens at http://localhost:<WEB_PORT>.
WEB_PORT=3000
# 127.0.0.1 = only this computer can open the app (safest).
# 0.0.0.0   = phones/computers on the same Wi-Fi can open http://<this Mac's IP>:<WEB_PORT>.
WEB_BIND=127.0.0.1

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=supun
POSTGRES_DB=supun
# random
POSTGRES_PASSWORD=change-me-db-password-0123456789

# ── Security ─────────────────────────────────────────────────────────────────
# Signs the login cookie. random, at least 16 characters.
JWT_SECRET=change-me-jwt-secret-0123456789abcdef
# Send the login cookie only over HTTPS. Keep false for http://localhost.
COOKIE_SECURE=false

# ── File storage (SeaweedFS, S3 API) ─────────────────────────────────────────
# random
S3_ACCESS_KEY=change-me-s3-access-key
# random
S3_SECRET_KEY=change-me-s3-secret-key-0123456789
S3_BUCKET=supun-docs

# ── Backups ──────────────────────────────────────────────────────────────────
# Encrypts every backup. WRITE IT DOWN and keep it safe (e.g. on paper with your bank papers):
# without this password NO backup can ever be restored — not even from Google Drive.
# random
RESTIC_PASSWORD=change-me-backup-password-0123456789
# When the nightly backup runs (cron format, Asia/Colombo time). Default: every day at 23:00.
BACKUP_SCHEDULE=0 23 * * *
# Folder on Google Drive (after running scripts/setup-gdrive.command).
GDRIVE_FOLDER=SupunConstructionBackup
# Optional: your own Google API client (better rate limits) — see README "Backups".
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# ── Sample data ──────────────────────────────────────────────────────────────
# true = load realistic sample data on the first start (only when there are no projects yet).
SEED_SAMPLE_DATA=true

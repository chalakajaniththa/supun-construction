{
  "name": "supun-construction",
  "version": "0.1.0",
  "private": true,
  "description": "Supun Construction — business management system",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "pnpm --filter @sc/shared build",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev": "pnpm dev:infra && pnpm -r --parallel --filter @sc/shared --filter @sc/api --filter @sc/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e:api": "pnpm --filter @sc/api test:e2e",
    "test:e2e:web": "pnpm --filter @sc/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}

# Supun Construction — .env for deploy/docker-compose.yml (the install scripts create this for you).
# Replace every "change-me-…" value with a long random text (e.g. `openssl rand -hex 24`).

# Image version: latest, or a release like 1.2.0
SC_VERSION=latest

# First login (change the password in Settings → Password after logging in)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Web: http://localhost:3000. WEB_BIND=0.0.0.0 lets phones on the same Wi-Fi open it.
WEB_PORT=3000
WEB_BIND=127.0.0.1
COOKIE_SECURE=false

# Database, file storage and login cookie
POSTGRES_USER=supun
POSTGRES_DB=supun
POSTGRES_PASSWORD=change-me-db-password
JWT_SECRET=change-me-jwt-secret-at-least-16-characters
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET=supun-docs

# BACKUP PASSWORD — write it on paper! Without it no backup can ever be restored.
RESTIC_PASSWORD=change-me-backup-password
BACKUP_SCHEDULE=0 23 * * *
GDRIVE_FOLDER=SupunConstructionBackup
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# true = load the sample data on the first start (Settings → Reset data can remove it later)
SEED_SAMPLE_DATA=true
